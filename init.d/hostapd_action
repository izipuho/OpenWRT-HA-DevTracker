#!/bin/sh /etc/rc.common

USE_PROCD=1
START=31
STOP=20

ACTION=/etc/hostapd_action

set_device_init_presence(){
        config_get iface "$1" iface
        config_get mac "$1" mac
        if [ "$iface" != "none" ]
        then
                state=online
        else
                state=offline
        fi
        /etc/hostapd_action $iface $state $mac
}

set_device_iface(){
        local phone="$1"
        local iface
        local mac
        local found_iface

        echo "  $phone"
        config_get mac "$phone" mac
        found_iface=none
        for iface in $ifaces
        do
                case "$iface" in
                        *-main-*)
                                #echo $(hostapd_cli -i $iface sta $mac)
                                if [ "$(hostapd_cli -i $iface sta $mac | head -n 1)" != "FAIL" ]
                                then
                                        echo "   true"
                                        found_iface=$iface
                                        break
                                fi
                        ;;
                esac
        done
        uci set hostapd_action.$phone.iface=$found_iface
}

start_service() {
#	if [ -f $PIDFILE ] && kill -0 $(cat $PIDFILE); then
#		echo 'Service already running'
#		return 1
#	fi

	config_load hostapd_action
	echo starting
        ifaces=$(hostapd_cli interface | tail -n +3)
        IFS=$'\n'
        for iface in $ifaces
        do
                echo " $iface"
                case "$iface" in
                        *-main-*)
                                procd_open_instance "$iface"
                                procd_set_param command hostapd_cli -i "$iface" -a "$ACTION" -r
                                procd_set_param stdout 1
                                procd_set_param stderr 1
                                procd_set_param respawn
                                procd_close_instance
                        ;;
                esac
        done

        config_foreach set_device_iface device
	uci commit hostapd_action
	config_load hostapd_action
	config_foreach set_device_init_presence device
	unset IFS
	echo started
}
