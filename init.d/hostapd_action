#!/bin/sh /etc/rc.common
config_load hostapd_action

USE_PROCD=1
START=31
STOP=20

ACTION=/etc/hostapd_action

set_device_init_presence(){
        config_get iface "$1" iface
        config_get mac "$1" mac
        if [ "$iface" != "none" ]
        then
                state=online
        else
                state=offline
        fi
        /etc/hostapd_action $iface $state $mac
}

set_device_iface(){
        local phone="$1"
        local iface
        local mac
        local found_iface

        echo "  $phone"
        config_get mac "$phone" mac
        found_iface=none
        for iface in $ifaces
        do
                case "$iface" in
                        *-main-*)
                                #echo $(hostapd_cli -i $iface sta $mac)
                                if [ "$(hostapd_cli -i $iface sta $mac | head -n 1)" != "FAIL" ]
                                then
                                        echo "   true"
                                        found_iface=$iface
                                        break
                                fi
                        ;;
                esac
        done
        uci set hostapd_action.$phone.iface=$found_iface
}

start_service() {
#	if [ -f $PIDFILE ] && kill -0 $(cat $PIDFILE); then
#		echo 'Service already running'
#		return 1
#	fi

	echo starting
        ifaces=$(hostapd_cli interface | tail -n +3)
        IFS=$'\n'
        for iface in $ifaces
        do
                echo " $iface"
                PIDFILE=/var/run/hostapd_action_$iface.pid
                case "$iface" in
                        *-main-*)
                                hostapd_cli -i $iface -a $ACTION -r -B -P $PIDFILE
                        ;;
                esac
        done

        config_foreach set_device_iface device
	uci commit hostapd_action
	config_load hostapd_action
	config_foreach set_device_init_presence device
	unset IFS
	echo started
}

stop_service() {
	echo stop
	for pidfile in /var/run/hostapd_action_*.pid; do
		[ -f "$pidfile" ] || continue
		pid=$(cat "$pidfile")
		if kill -0 "$pid" 2>/dev/null; then
			kill "$pid"
			wait "$pid" 2>/dev/null
		fi
		rm -f "$pidfile"
	done
	echo stopped
}
